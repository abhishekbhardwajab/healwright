# Export these before `npm start` (or keep them in an untracked .env and load it yourself).
# All are optional; see README "Configuration".
# PORT=3000
# DATA_DIR=./data
# STUDIO_TOKEN=
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_HEAL_MIN_CONFIDENCE=0.7
# AWS / AgentCore (see docs/AGENTCORE.md)
# AI_PROVIDER=bedrock
# AI_FALLBACK_MODEL=anthropic.claude-opus-4-8
# BROWSER_PROVIDER=agentcore
# AGENTCORE_BROWSER_ID=aws.browser.v1
# AWS_REGION=us-west-2
